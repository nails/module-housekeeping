{
    "name": "nails/module-housekeeping",
    "description": "A generic orchestrator for cleanup and housekeeping routines in Nails applications",
    "homepage": "https://docs.nailsapp.co.uk/modules/housekeeping",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nails/common": "dev-develop",
        "nails/module-console": "dev-develop",
        "nails/module-cron": "dev-develop"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "nails/module-admin": "dev-develop"
    },
    "autoload": {
        "psr-4": {
            "Nails\\Housekeeping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Housekeeping\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "extra": {
        "nails": {
            "moduleName": "housekeeping",
            "type": "module",
            "namespace": "Nails\\Housekeeping\\"
        }
    }
}
